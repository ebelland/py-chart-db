__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# The log files, not the logger.  This rule used to be "logs/", which
# also matched app/logs/ and so kept app/logs/logger.py - the application's
# own logger - out of the repository entirely: a fresh clone could not even
# start, because every module imports it.
# The .* variant catches the rotated files (datahub.log.1, .2, ...), which
# "*.log" alone does not match and which were showing up as untracked.
*.log
*.log.*
*.dhub
*.7z
*.zip
.DS_Store
.vscode/
app/test_results/
*.dhub-wal
*.dhub-shm
.fuse_hidden*

# "sample data/" itself IS tracked: demo_project.py reads all sixteen of its
# files to build the demo set, so a clone without them cannot build a demo
# and roughly twenty tests fail on a missing file. Two strays in that folder
# are not read by any code and stay out (dataset_tbc.csv is a megabyte on its
# own); the built .dhub next to them is generated, and *.dhub above covers it.
sample data/dataset_tbc.csv
sample data/penguins_raw.csv

# The built demo set IS tracked, against the usual "no build output in git"
# rule, and deliberately: "Load demo" copies a pre-built file and raises if
# it is missing (demo_project.copy_demo_project), so a clone without demo/
# has no working demo at all until somebody thinks to run the builder. The
# .dhub files are the product here, not an intermediate. ~3 MB, rebuilt with
# `python -m app.data.demo_project` whenever the figures change - re-run it
# after editing demo_project.py or the set goes stale.
!demo/
!demo/*.dhub

# "Load demo" drops its working copy here before opening it (demo_project.PROJECTS_DIR)
projects/

# Compiled gettext catalogues (rebuilt from the .po on load)
app/locales/**/*.mo

# Sync-conflict duplicates ("file 2.py") left by iCloud/OneDrive-style tools.
# They are not edits: a stray "scatter 2.py" under app/charts would be
# read by the renderer scanner as a second, stale renderer.
* 2.*
* 2
* [0-9].*
*.7z

# Staging area for files awaiting deletion, and the tarballs left in it.
_to_delete/

# Screenshots are committed; anything else generated under docs is not.
docs/**/*.tmp

# Written by the application as it runs: last database, window geometry,
# per-dialog entries, chosen style and language. One machine's settings, not
# the project's - config.json is the versioned half of that pair.
user.json
